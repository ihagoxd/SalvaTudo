{
  // O projeto é JavaScript puro (sem etapa de build). O TypeScript só confere
  // os tipos: "npm run tipos" acusa erro antes de chegar ao usuário.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "electron/**/*.js", "scripts/**/*.js", "test/**/*.js", "public/js/**/*.js"],
  "exclude": ["node_modules", "dist", "dados"]
}
